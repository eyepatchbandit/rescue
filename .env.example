# Solana bot runtime configuration. Set these in the bot's process environment.
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_DELEGATE=<delegate-public-key>
SOLANA_MAINNET_DELEGATE_PRIVATE_KEY=<delegate-secret-key>
SOLANA_MAINNET_DESTINATION=<cold-wallet-public-key>

# Frontend build-time values must match the server values exactly.
NEXT_PUBLIC_SOLANA_DELEGATE=<delegate-public-key>
NEXT_PUBLIC_SOLANA_DESTINATION=<cold-wallet-public-key>
NEXT_PUBLIC_SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com

# Robinhood Chain (mainnet, chain ID 4663)
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
